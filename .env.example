# Copy file này thành .env rồi điền giá trị thật — .env đã nằm trong
# .gitignore, không bao giờ commit file .env thật lên git.

# "anthropic" (Claude) hoặc "openai" — bắt buộc.
LLM_PROVIDER=anthropic

# Điền đúng 1 trong 2 key tương ứng với LLM_PROVIDER ở trên.
# Lấy Anthropic key tại: https://console.anthropic.com/settings/keys
# Lấy OpenAI key tại:    https://platform.openai.com/api-keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Tài khoản SSH dùng để đăng nhập thiết bị mạng trong inventory.yaml —
# khuyến nghị dùng tài khoản riêng, giới hạn privilege level thấp (chỉ đủ
# chạy lệnh show), tách biệt với tài khoản quản trị chính.
NETWORK_USERNAME=
NETWORK_PASSWORD=
# Enable secret — để trống thì dùng chung giá trị NETWORK_PASSWORD.
NETWORK_ENABLE_SECRET=

# --- Tuỳ chọn, chỉ cần khi muốn đổi hành vi mặc định ---

# Override model mặc định của LLM_PROVIDER (vd đổi sang model mạnh hơn nếu
# agent hay chọn sai tool/thiết bị).
MODEL_NAME=

# CHỈ dùng khi LLM_PROVIDER=openai: trỏ sang endpoint OpenAI-compatible
# khác (Azure OpenAI, FPT AI Marketplace, v.v.) thay vì OpenAI thật. Nếu
# đặt biến này thì bắt buộc phải điền MODEL_NAME đúng tên model mà endpoint
# đó cung cấp.
OPENAI_BASE_URL=
